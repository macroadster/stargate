{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@howssatoshi/quantumcss": "1.17.2",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-window": "^2.5.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.15.1",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "postinstall": "npm run build:wasm",
    "build:wasm": "cp node_modules/sql.js/dist/sql-wasm*.wasm public/",
    "start": "vite",
    "build": "npm run build:wasm && vite build && node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "test": "NODE_NO_WARNINGS=1 vitest",
    "test:e2e": "npx playwright test frontend/tests/selection.spec.js",
    "test:watch": "NODE_NO_WARNINGS=1 vitest --watch",
    "test:real": "npx playwright test tests/mcp_workflow_real.spec.js --headed",
    "test:real:headless": "npx playwright test tests/mcp_workflow_real.spec.js",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "svgo": ">=4.0.3 <5",
    "brace-expansion": ">=1.1.21 <2",
    "js-yaml": ">=4.3.2 <5",
    "nanoid": ">=3.3.18 <4",
    "browserslist": ">=4.28.7 <5",
    "baseline-browser-mapping": ">=2.11.0 <3",
    "postcss-selector-parser": ">=7.1.3 <8",
    "@humanfs/node": ">=0.16.8 <1",
    "@vitest/mocker": ">=5.0.5 <6"
  }
}
